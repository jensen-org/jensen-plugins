{
  "id": "dev.jensen.impact",
  "name": "Impact",
  "version": "0.1.0",
  "minAppVersion": "0.0.0",
  "description": "Show what a file change would affect, read from the code graph.",
  "author": "Jensen",
  "entry": { "wasm": "plugin.wasm", "ui": "ui/index.html" },
  "contributes": {
    "commands": [{ "id": "impact.check", "title": "Impact of File" }],
    "panels": [{ "id": "impact.panel", "label": "Impact" }],
    "themes": [],
    "views": []
  },
  "permissions": { "graph": true },
  "activationEvents": ["onCommand:impact.check", "onPanel:impact.panel"]
}
